<section class="page-width section cart-page"><span class="eyebrow">Your little finds</span><h1>Your bag</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-items">{% for item in cart.items %}<div class="cart-line">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 220 | image_tag: alt: item.title }}</a>{% endif %}<div class="cart-line-info"><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><small>{{ item.variant.title }}</small><label for="updates_{{ item.key }}">Qty</label><input id="updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><a class="text-link" href="{{ item.url_to_remove }}">Remove</a></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><div class="cart-summary"><button class="button button-light" type="submit" name="update">Update bag</button><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><small>Shipping and applicable taxes are calculated at checkout.</small><button class="button button-dark button-full" type="submit" name="checkout">Continue to checkout</button></div></form>{% else %}<div class="empty-state"><p>Your bag is waiting for something lovely.</p><a class="button button-dark" href="{{ routes.all_products_collection_url }}">Explore the shop</a></div>{% endif %}</section>{% schema %}{"name":"Cart","settings":[]}{% endschema %}