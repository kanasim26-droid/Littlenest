<section class="page-width section"><div class="collection-intro">{% if collection.image %}{{ collection.image | image_url: width: 1400 | image_tag: class: 'collection-hero-image', alt: collection.title }}{% endif %}<span class="eyebrow">The LittleNest collection</span><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</div><div class="collection-toolbar"><span>{{ collection.products_count }} lovely finds</span><form method="get"><label for="SortBy">Sort by</label><select id="SortBy" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div>{% paginate collection.products by 12 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products here just yet. Please check back soon.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</section>{% schema %}{"name":"Collection products","settings":[]}{% endschema %}