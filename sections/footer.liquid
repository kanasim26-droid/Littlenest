<footer class="site-footer"><div class="page-width footer-grid"><div><a class="brand footer-brand" href="{{ routes.root_url }}"><span class="brand-name">{{ shop.name | default: 'LittleNest' }}</span><span class="brand-tagline">soft beginnings</span></a><p>Thoughtful essentials for life's tiniest beginnings. Soft textures, gentle details and comfort for your little one.</p></div><div><h3>Explore</h3>{% for link in section.settings.menu.links %}<a class="footer-link" href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div><div><h3>Customer care</h3><a class="footer-link" href="/pages/contact">Contact us</a><a class="footer-link" href="/policies/shipping-policy">Shipping policy</a><a class="footer-link" href="/policies/refund-policy">Returns</a></div><div><h3>Little notes</h3><p>New arrivals, gifting ideas and gentle everyday inspiration.</p>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Your email address" aria-label="Email address" required><button type="submit">Join</button>{% endform %}</div></div><div class="page-width footer-bottom">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. <span>Made with care for little beginnings ♡</span></div></footer>{% schema %}{"name":"Footer","settings":[{"type":"link_list","id":"menu","label":"Footer menu","default":"footer"}]}{% endschema %}