<section class="page-width product-page"><div class="product-gallery">{% for media in product.media %}<div class="product-gallery-item">{{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}</div>{% else %}<div class="image-placeholder large">LittleNest</div>{% endfor %}</div><div class="product-details"><nav class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.all_products_collection_url }}">Shop</a></nav><p class="eyebrow">{{ product.vendor | default: 'LittleNest essentials' }}</p><h1>{{ product.title | escape }}</h1><div class="product-detail-price">{% render 'price', product: product %}</div>{% if product.description != blank %}<div class="product-description rte">{{ product.description }}</div>{% endif %}{% form 'product', product, id: 'ProductForm', class: 'product-form' %}{% unless product.has_only_default_variant %}<label for="VariantSelect">Choose an option</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="Quantity">Quantity</label><div class="quantity-control"><button type="button" data-quantity-minus>−</button><input id="Quantity" name="quantity" type="number" min="1" value="1"><button type="button" data-quantity-plus>+</button></div><button class="button button-dark button-full" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{{ form | payment_button }}{% endform %}<div class="product-promises"><p>♡ Thoughtfully selected for little ones</p><p>📦 Delivery options shown at checkout</p><p>🔒 Secure checkout powered by Shopify</p></div></div></section>{% schema %}{"name":"Product information","settings":[]}{% endschema %}