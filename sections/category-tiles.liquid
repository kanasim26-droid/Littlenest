<section class="section page-width"><div class="section-heading"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="category-grid">{% for block in section.blocks %}{% assign chosen = block.settings.collection %}<a class="category-tile" href="{% if chosen != blank %}{{ chosen.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}{% elsif chosen.featured_image %}{{ chosen.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: chosen.title }}{% elsif block.settings.title contains 'Sleepsuits' %}<img src="https://raw.githubusercontent.com/kanasim26-droid/Littlenest/main/src/assets/images/product_knit_romper_1793176728603.jpg" alt="{{ block.settings.title | escape }}" loading="lazy">{% elsif block.settings.title contains 'Blankets' %}<img src="https://raw.githubusercontent.com/kanasim26-droid/Littlenest/main/src/assets/images/product_swaddle_set_1793176729232.jpg" alt="{{ block.settings.title | escape }}" loading="lazy">{% elsif block.settings.title contains 'Gift' %}<img src="https://raw.githubusercontent.com/kanasim26-droid/Littlenest/main/src/assets/images/product_gift_bundle_1793176729526.jpg" alt="{{ block.settings.title | escape }}" loading="lazy">{% elsif block.settings.title contains 'Socks' or block.settings.title contains 'Hats' %}<img src="https://raw.githubusercontent.com/kanasim26-droid/Littlenest/main/src/assets/images/hero_newborn_clothing_1793176730078.jpg" alt="{{ block.settings.title | escape }}" loading="lazy">{% else %}<div class="image-placeholder">LittleNest</div>{% endif %}<span class="category-overlay"><strong>{{ block.settings.title | default: chosen.title | escape }}</strong><span>Explore collection ↗</span></span></a>{% endfor %}</div></section>{% schema %}{"name":"Shop by category","max_blocks":6,"blocks":[{"type":"category","name":"Category","settings":[{"type":"text","id":"title","label":"Title","default":"Newborn essentials"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image"}]}],"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Find your little something"},{"type":"text","id":"heading","label":"Heading","default":"A little world of lovely things"}],"presets":[{"name":"Shop by category","blocks":[{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}