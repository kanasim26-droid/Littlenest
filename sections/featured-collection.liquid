<section class="section page-width"><div class="section-heading"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.subheading | escape }}</p></div>{% if section.settings.collection %}<a class="text-link" href="{{ section.settings.collection.url }}">View all →</a>{% endif %}</div><div class="product-grid">{% assign chosen = section.settings.collection %}{% if chosen != blank %}{% for product in chosen.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}{% else %}{% for product in collections.all.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}{% endif %}</div></section>{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Little favourites"},{"type":"text","id":"heading","label":"Heading","default":"Made for moments you'll remember"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Soft, practical essentials for the tiniest days and the biggest feelings."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Featured collection"}]}{% endschema %}