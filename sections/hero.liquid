<section class="hero-section"><div class="hero-copy"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p><a class="button button-dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} →</a><div class="hero-note">✳ Thoughtfully chosen for your tiniest love</div></div><div class="hero-image-wrap">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: class: 'hero-image', loading: 'eager', alt: section.settings.heading }}{% else %}<img class="hero-image" src="https://raw.githubusercontent.com/kanasim26-droid/Littlenest/main/src/assets/images/hero_newborn_clothing_1793176730078.jpg" alt="Soft newborn clothing and baby essentials" width="1200" height="1300">{% endif %}<div class="hero-stamp">soft<strong>beginnings</strong><small>since day one</small></div></div></section>{% schema %}{"name":"LittleNest hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A softer start to every little story"},{"type":"text","id":"heading","label":"Heading","default":"Little things. Big love."},{"type":"textarea","id":"text","label":"Description","default":"Discover gentle newborn essentials, thoughtfully chosen for cuddles, comfort and all the beautiful firsts."},{"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"image_picker","id":"image","label":"Hero image"}]}{% endschema %}