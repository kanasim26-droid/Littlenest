<header class="site-header"><div class="page-width header-inner"><details class="mobile-menu"><summary>☰</summary><nav>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav></details><a class="brand" href="{{ routes.root_url }}">{% if settings.logo %}{{ settings.logo | image_url: width: 340 | image_tag: class: 'brand-logo', alt: shop.name }}{% else %}<span class="brand-name">{{ shop.name | default: 'LittleNest' }}</span><span class="brand-tagline">soft beginnings</span>{% endif %}</a><nav class="desktop-nav">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav><div class="header-actions"><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Bag <span class="count-bubble" data-cart-count>{{ cart.item_count }}</span></a></div></div></header>{% schema %}{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}