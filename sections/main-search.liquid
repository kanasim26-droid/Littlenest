<section class="page-width section"><span class="eyebrow">Find something lovely</span><h1>Search LittleNest</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search newborn essentials..." aria-label="Search products"><input type="hidden" name="type" value="product"><button class="button button-dark" type="submit">Search</button></form>{% if search.performed %}<p>{{ search.results_count }} results</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Search results","settings":[]}{% endschema %}