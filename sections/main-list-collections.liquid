<section class="page-width section"><div class="collection-intro"><span class="eyebrow">Find your little something</span><h1>Shop collections</h1><p>Thoughtfully chosen essentials for your tiniest love.</p></div><div class="category-grid">{% for collection in collections %}{% unless collection.handle == 'frontpage' or collection.handle == 'all' %}<a class="category-tile" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}<div class="image-placeholder">LittleNest</div>{% endif %}<span class="category-overlay"><strong>{{ collection.title | escape }}</strong><span>{{ collection.products_count }} little finds ↗</span></span></a>{% endunless %}{% endfor %}</div></section>{% schema %}{"name":"Collection list","settings":[]}{% endschema %}